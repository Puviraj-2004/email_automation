# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5436/email_automation"

# Server
PORT=4000
NODE_ENV=development

# File storage
UPLOADS_DIR=./uploads/emails

# Public base URL (used to build attachment URLs)
PUBLIC_BASE_URL=http://localhost:4000

# Robot scheduler — cron expression
ROBOT_CRON_SCHEDULE="* * * * *"

# Auto-create accounts at startup (JSON array)
# AUTO_EMAIL_ACCOUNTS_JSON='[{"label":"Gonesse","email":"gonesse@gopservices.fr","password":"secret"}]'