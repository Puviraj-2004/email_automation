# Database
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="replace-with-a-strong-postgres-password"
POSTGRES_DB="email_automation"
POSTGRES_PORT="5436"
DATABASE_URL="postgresql://postgres:replace-with-a-strong-postgres-password@localhost:5436/email_automation"

# Server
PORT=4000
NODE_ENV=development

# File storage
UPLOADS_DIR=./uploads/emails

# Public base URL (used to build attachment URLs)
PUBLIC_BASE_URL=http://localhost:4000

# Robot scheduler — cron expression (default: every hour)
ROBOT_CRON_SCHEDULE="0 * * * *"

# API security
# Required in production. Send as x-api-key or Authorization: Bearer <key>.
API_KEY="replace-with-a-long-random-api-key"

# Credential encryption
# Required in production. Use a long random value and keep it outside source control.
CREDENTIAL_ENCRYPTION_KEY="replace-with-a-long-random-encryption-secret"

# Optional local seeding only. Keep real credentials out of source control.
SEED_EMAIL_ACCOUNTS_JSON="[]"
