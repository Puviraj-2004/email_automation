# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/email_automation"

# Server
PORT=4000
NODE_ENV=development

# File storage
UPLOADS_DIR=./uploads/emails

# Public base URL (used to build attachment URLs)
PUBLIC_BASE_URL=http://localhost:4000

# Robot scheduler — cron expression (default: every hour)
ROBOT_CRON_SCHEDULE="0 * * * *"